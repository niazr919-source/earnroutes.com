# Copy to .env.local and fill in after Google approves the site for AdSense.
# Until this is set: the AdSense script is not loaded, ad slots render nothing,
# and /ads.txt returns 404 — which is the correct state to submit for review in.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Example once approved:
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
